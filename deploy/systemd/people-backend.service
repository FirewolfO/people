[Unit]
Description=People Backend
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=%h/code/people/backend
EnvironmentFile=-%h/code/people/backend/.env
ExecStartPre=/usr/bin/mkdir -p %h/.local/libexec
ExecStartPre=/usr/local/go/bin/go build -o %h/.local/libexec/people-server ./cmd/server
ExecStart=%h/.local/libexec/people-server
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
